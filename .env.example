# Live: vLLM chat + OpenAI Image Gen photo editing and advertisement design.
MODEL_MODE=fake
# In Docker, point to the vLLM HTTP endpoint reachable from the container.
VLLM_BASE_URL=http://host.docker.internal:8000/v1
# docker-compose.grpc.yml 전용 내부 포트이며 호스트에는 게시하지 않습니다.
VLLM_INTERNAL_PORT=18080
VLLM_SOURCE_MODEL=Qwen/Qwen3-4B
VLLM_MODEL=hotel-agent
VLLM_API_KEY=EMPTY
VLLM_CONTEXT_TOKENS=12288
VLLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_TIMEOUT_SECONDS=25
# Required for V2 live image editing and the legacy V1 image endpoint.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=high
IMAGE_TIMEOUT_SECONDS=150
BACKEND_DOCKER_NETWORK=fastapi-backend_default

# 3: parallel image requests; 1: sequential rollback.
IMAGE_MAX_CONCURRENCY=3
