# live: Qwen 기획 대화 + OpenAI 사진 분석 + 로컬 사진 보정·문구 합성
MODEL_MODE=live

# 같은 Docker 네트워크에 있는 vLLM 컨테이너 주소
VLLM_BASE_URL=http://vllm:18080/v1
VLLM_INTERNAL_PORT=18080

VLLM_SOURCE_MODEL=Qwen/Qwen3-4B
VLLM_MODEL=hotel-agent
VLLM_API_KEY=EMPTY
VLLM_CONTEXT_TOKENS=12288
VLLM_TIMEOUT_SECONDS=25
VLLM_GPU_MEMORY_UTILIZATION=0.80

# 실제 키 입력
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=high
IMAGE_TIMEOUT_SECONDS=300
IMAGE_MAX_CONCURRENCY=3

# 실제 백엔드 Docker 네트워크 이름과 일치해야 함
BACKEND_DOCKER_NETWORK=fastapi-backend_default
