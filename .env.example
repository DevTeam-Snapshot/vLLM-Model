# fake: no GPU or paid API calls. live: vLLM chat + paid OpenAI image generation.
MODEL_MODE=fake
# In Docker, point to the vLLM HTTP endpoint reachable from the container.
VLLM_BASE_URL=http://host.docker.internal:8000/v1
VLLM_MODEL=hotel-agent
VLLM_API_KEY=EMPTY
VLLM_CONTEXT_TOKENS=12288
VLLM_TIMEOUT_SECONDS=25
OPENAI_API_KEY=
IMAGE_MODEL=gpt-image-2
IMAGE_TIMEOUT_SECONDS=150
BACKEND_DOCKER_NETWORK=fastapi-backend_default
